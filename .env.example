# Copy to .env and fill in real values. Never commit .env.

# Postgres in production (docker-compose provides this). Falls back to local SQLite if unset.
DATABASE_URL=postgresql+psycopg2://courtbot:courtbot@db:5432/courtbot

# Random 32+ char string used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me

# Fernet key used to encrypt stored facility credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me

# Default timezone used when a facility doesn't specify its own (IANA name).
DEFAULT_TIMEZONE=America/Los_Angeles

# How many seconds before the exact booking-window opening time the worker should
# pre-warm (open browser, log in, navigate to the target date) before spin-waiting
# for the precise moment to submit the booking.
PREWARM_LEAD_SECONDS=90

# Run Playwright browsers headless (true in production/servers without a display).
PLAYWRIGHT_HEADLESS=true

# Optional: route every browser launch through a proxy. Needed if the facility's site
# blocks this server's own IP (common with Cloudflare-protected sites blocking datacenter/
# hosting-provider IP ranges outright -- see README "Datacenter IPs getting blocked").
# Leave all three blank to connect directly.
# server format is host:port, e.g. isp.example-provider.com:12345
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
